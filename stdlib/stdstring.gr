use {"stdlib/stdarray.gr"}

space std{


    fn charToCode(y){
        var temp = 0
        chrti(temp,y)
        return temp
    }

    fn codeToChar(y){
        var tempp = 0
        itchr(tempp,y)
        return tempp
    }

    fn hash(str) {
        var h = 0
        var i = 0

        while( i < std.size(str) ){
            h = h * 31 + std.charToCode(str[i]) % 1000000007
            i = i + 1
        }

        return h
    }

        fn djbhash(str) {
        var h = 5381
        var i = 0

        while (i < std.size(str)) {
            h = h * 33 + std.charToCode(str[i])
            i = i + 1
        }

        return h
    }


    fn encode(str) {
        var result = 0
        var multiplier = 1
        var i = 0

        while (i < std.size(str)) {
            result = result + (std.charToCode(str[i]) + 1) * multiplier
            multiplier = multiplier * 129
            i = i + 1
        }

        return result
    }

    fn decode(encoded) {
        var result = 0
        var n = encoded

        while (n > 0) {
            var digit = n % 129
            result = result + std.codeToChar(digit - 1)
            n = (n - digit) / 129
        }

        return result
    }

    fn split(text,delimiter){
        var buffer1 = ""
        var buffer2 = ""
        var switch = false
        for(character : text){
            if(switch == false){
                buffer1 = buffer1+character
                if(character == delimiter){
                    switch = true
                }
            }else{
                buffer2 = buffer2 + character
            }
        }

        var result = [buffer1,buffer2]
        return result
    }

    fn join(input,delimiter){
        var result = ""
        var i = 0
        for (text in input){
            i = i+1

            if(i is std.size(input)){
                result = result + text
            }else{
                result = result + text + delimiter
            }
        }

        return result
    }

    fn replaceChr(input,before,after)
    {

        var replace = input
        var i = 0
        for(chr in replace){
            if(chr is before){
                replace[i] = after
            }

            i=i+1
        }

        return replace
    }
    fn replace(input,before,after)
    {

        var replace = input
        var i = 0
        var sizeOfReplacement = std.size(before)
        var replaced = false
        var frst = before[0]

        var fulfilled = 0
        for(chr in replace){
            if(chr is frst && fulfilled < std.size(before)){
                fulfilled = fulfilled+1
                replace[i] = after
                replace[sizeOfReplacement+i] = ""
                replaced = true
            }

            i=i+1
        }

        return replace
    }

}