space std{
    fn size(string str){
        var val = 0;
        size(str, val);
        return val;
    }

fn split(input , delimiter){
    var result = []; 
    var currentWord = "";
    var i = 0;

    while(i < std.size(input)){
        if(input[i] == delimiter){
            append(result, currentWord); 
            currentWord = ""; 
        }
        else {
            currentWord = currentWord + input[i];
        }
        i = i + 1;
    }
    append(result, currentWord); 

    return result;
}

}