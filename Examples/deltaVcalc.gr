use "stdlib"

fn deltaV(double isp, double wetMass, double dryMass){
    const g0 = 9.086
    return g0 * isp * std.ln(wetMass/dryMass)
}

var result = deltaV(std.double(std.prompt("ISP:")),std.double(std.prompt("Wet Mass:")),std.double(std.prompt("Dry Mass:")))

std.print("Delta-V: " + result + " m/s")